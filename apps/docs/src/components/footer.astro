---
/** 页脚：一句话 + 链接行，发丝线分隔。 */
import L from "~/components/L.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-hairline)]">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 py-10 sm:flex-row sm:px-8"
  >
    <div class="flex items-center gap-2.5">
      <span class="logo-dot" aria-hidden="true"><i></i></span>
      <span class="text-[13px] font-semibold">Lettura</span>
      <span class="text-[12px] text-[var(--color-ter)]"><L en="— a local-first feed reader. MIT," zh="—— 本地优先的订阅阅读器。MIT," /> {year}.</span>
    </div>
    <nav class="flex items-center gap-6 text-[13px] text-[var(--color-text-offset)]">
      <a class="hover:text-[var(--color-text)]" href="https://github.com/zhanglun/lettura" target="_blank" rel="noopener"><L en="GitHub" zh="GitHub" /></a>
      <a class="hover:text-[var(--color-text)]" href="https://github.com/zhanglun/lettura/releases" target="_blank" rel="noopener"><L en="Releases" zh="Releases" /></a>
      <a class="hover:text-[var(--color-text)]" href="https://github.com/zhanglun/lettura/issues" target="_blank" rel="noopener"><L en="Issues" zh="Issues" /></a>
    </nav>
  </div>
</footer>

<style>
  .logo-dot {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    background: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .logo-dot i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-background);
  }

  [data-theme="dark"] .logo-dot {
    background: var(--color-primary);
  }

  [data-theme="dark"] .logo-dot i {
    background: var(--color-background);
  }
</style>
