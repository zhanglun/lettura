---
/** 播放器三态段：三帧小图并排（podcast.html 契约），双语短句。 */
import L from "~/components/L.astro";
---

<section id="player" class="mx-auto max-w-6xl scroll-mt-24 py-16">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <p class="section-eyebrow"><L en="PODCASTS, NOT AN AFTERTHOUGHT" zh="播客不是附属品" /></p>
    <p class="text-[12.5px] text-[var(--color-ter)]">
      <L en="space anywhere · esc collapses · keeps playing collapsed" zh="space 随处播放 · esc 收起 · 收起也照常播" />
    </p>
  </div>
  <h2 class="mt-4 max-w-xl text-2xl font-bold tracking-tight sm:text-[28px]">
    <L en="A podcast is an article." zh="播客即文章。" />
  </h2>

  <div class="mt-10 grid gap-5 lg:grid-cols-[2fr_3fr_auto]">
    <!-- 帧 1：条 -->
    <figure class="frame">
      <div class="frame-stage">
        <div class="mini-bar">
          <span class="mb-core"><svg width="8" height="8" viewBox="0 0 12 12" fill="#fff"><rect x="1.5" y="1" width="3" height="10" rx="1"/><rect x="7.5" y="1" width="3" height="10" rx="1"/></svg></span>
          <span class="mb-lines"><i></i><i style="width:70%"></i><i style="width:45%"></i></span>
          <span class="mb-track"><b></b></span>
          <span class="mb-chip">1.5×</span>
        </div>
      </div>
      <figcaption><b><L en="Bar" zh="条" /></b> — <L en="always there, never in the way" zh="一直在，不挡路" /></figcaption>
    </figure>

    <!-- 帧 2：沉浸页 -->
    <figure class="frame">
      <div class="frame-stage">
        <div class="mini-full">
          <span class="mf-cover"></span>
          <span class="mf-title"></span>
          <span class="mf-sub"></span>
          <span class="mf-track"><b></b></span>
          <span class="mf-row now"></span>
          <span class="mf-row"></span>
          <span class="mf-row"></span>
        </div>
      </div>
      <figcaption><b><L en="Full player" zh="沉浸页" /></b> — <L en="big cover, transport, up next" zh="大封面 · 传输 · 接着播" /></figcaption>
    </figure>

    <!-- 帧 3：圆钮 -->
    <figure class="frame">
      <div class="frame-stage flex items-center justify-center">
        <span class="mini-pill">
          <svg width="40" height="40" viewBox="0 0 40 40">
            <circle cx="20" cy="20" r="18.5" fill="none" stroke="rgba(29,30,32,.1)" stroke-width="2"/>
            <circle cx="20" cy="20" r="18.5" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-dasharray="116.2" stroke-dashoffset="80"/>
          </svg>
          <i></i>
        </span>
      </div>
      <figcaption><b><L en="Pill" zh="圆钮" /></b> — <L en="collapse it, keep listening" zh="收起它，继续听" /></figcaption>
    </figure>
  </div>
</section>

<style>
  .frame {
    border: 1px solid var(--color-hairline);
    border-radius: 14px;
    background: var(--color-card);
    padding: 14px 14px 12px;
  }

  .frame figcaption {
    margin-top: 10px;
    font-size: 12px;
    color: var(--color-text-offset);
  }

  .frame figcaption b {
    color: var(--color-text);
    font-weight: 600;
  }

  .frame-stage {
    height: 150px;
    border-radius: 10px;
    border: 1px solid var(--color-hairline);
    background: var(--color-background);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  /* 条 */
  .mini-bar {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    height: 34px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px;
    border-radius: 9px;
    border: 1px solid var(--color-hair2);
    background: var(--color-panel);
    box-shadow: 0 10px 22px -10px rgba(29, 30, 32, 0.3);
  }

  .mb-core {
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .mb-lines {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: none;
    width: 56px;
  }

  .mb-lines i {
    height: 3px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-text) 18%, transparent);
  }

  .mb-track {
    flex: 1;
    height: 3px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-text) 10%, transparent);
    position: relative;
  }

  .mb-track b {
    position: absolute;
    inset: 0;
    width: 40%;
    border-radius: 999px;
    background: var(--color-primary);
  }

  .mb-chip {
    font-size: 9px;
    color: var(--color-text-offset);
    background: var(--color-card);
    border-radius: 4px;
    padding: 2px 6px;
    flex: none;
  }

  /* 沉浸页 */
  .mini-full {
    position: absolute;
    inset: 10px;
    border-radius: 9px;
    border: 1px solid var(--color-hair2);
    background: var(--color-panel);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px 16px 10px;
    gap: 6px;
  }

  .mf-cover {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    box-shadow: 0 8px 18px -6px color-mix(in srgb, var(--color-primary) 40%, transparent);
  }

  .mf-title {
    width: 62%;
    height: 5px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-text) 40%, transparent);
  }

  .mf-sub {
    width: 40%;
    height: 4px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-text) 14%, transparent);
  }

  .mf-track {
    width: 100%;
    height: 3px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-text) 10%, transparent);
    position: relative;
    margin: 2px 0;
  }

  .mf-track b {
    position: absolute;
    inset: 0;
    width: 30%;
    border-radius: 999px;
    background: var(--color-primary);
  }

  .mf-row {
    width: 100%;
    height: 12px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--color-text) 6%, transparent);
  }

  .mf-row.now {
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
  }

  /* 圆钮 */
  .mini-pill {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--color-hair2);
    background: var(--color-panel);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 24px -10px rgba(29, 30, 32, 0.3);
  }

  .mini-pill svg {
    position: absolute;
    inset: -1px;
    transform: rotate(-90deg);
  }

  .mini-pill i {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--color-primary);
    box-shadow: 0 3px 8px -1px color-mix(in srgb, var(--color-primary) 50%, transparent);
  }
</style>
