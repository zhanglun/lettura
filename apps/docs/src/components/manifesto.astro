---
/** Manifesto：一句话哲学（app mock 语气：短句，不解释）。 */
import L from "~/components/L.astro";
---

<section class="mx-auto max-w-6xl py-20 sm:py-28">
  <div class="mx-auto max-w-2xl text-center">
    <p class="section-eyebrow"><L en="WHY LETTURA" zh="为什么是 LETTURA" /></p>
    <p class="mt-8 text-2xl font-semibold leading-snug tracking-tight sm:text-[32px] sm:leading-snug">
      <L
        en="Unread is not a debt. It's today's weather."
        zh="未读不是债务，只是今天的天气。"
      />
    </p>

  </div>
</section>
