---
import ThemeSwitcher from "~/components/theme-switcher.astro";
import L from "~/components/L.astro";
import type { NavItem } from "~/types";

const navItems: Array<NavItem> = [
  { title: "Features", url: "#features" },
  { title: "Player", url: "#player" },
  { title: "Download", url: "#download" },
];
---

<header
  class="sticky top-0 z-20 border-b border-[var(--color-hairline)] bg-[var(--color-background)]/80 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3 sm:px-8"
  >
    <a class="flex items-center gap-2.5" href="#">
      <span class="logo-dot" aria-hidden="true"><i></i></span>
      <span class="text-[14px] font-semibold tracking-tight">Lettura</span>
    </a>
    <div class="flex items-center gap-5">
      <nav class="hidden sm:block" aria-label="Sections">
        <ul class="flex items-center gap-5">
          {
            navItems.map(({ title, url }) => (
              <li>
                <a
                  class="text-[13px] text-[var(--color-text-offset)] hover:text-[var(--color-text)]"
                  href={url}
                >
                  <L
                    en={title}
                    zh={{ Features: "能力", Player: "播放器", Download: "下载" }[title] ?? title}
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a
        class="hidden text-[13px] text-[var(--color-text-offset)] hover:text-[var(--color-text)] sm:block"
        href="https://github.com/zhanglun/lettura"
        target="_blank"
        rel="noopener"
      >
        <L en="GitHub" zh="GitHub" />
      </a>
      <button
        id="lang-switcher"
        type="button"
        class="text-[13px] text-[var(--color-text-offset)] hover:text-[var(--color-text)]"
        aria-label="切换语言 / Switch language"
      >
        <L en="中文" zh="EN" />
      </button>
      <ThemeSwitcher />
    </div>
  </div>
</header>

<script>
  const langBtn = document.querySelector("#lang-switcher");

  langBtn?.addEventListener("click", () => {
    const next =
      (document.documentElement.dataset.lang || "en") === "en" ? "zh" : "en";
    document.documentElement.dataset.lang = next;
    localStorage.setItem("lang", next);
    document.documentElement.lang = next === "zh" ? "zh-CN" : "en";
    document.title =
      next === "zh"
        ? "Lettura — 本地优先的订阅阅读器"
        : "Lettura — a local-first feed reader";
  });
</script>

<style>
  .logo-dot {
    width: 20px;
    height: 20px;
    border-radius: 7px;
    background: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .logo-dot i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-background);
  }

  [data-theme="dark"] .logo-dot {
    background: var(--color-primary);
  }

  [data-theme="dark"] .logo-dot i {
    background: var(--color-background);
  }
</style>
