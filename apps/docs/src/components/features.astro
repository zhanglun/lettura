---
/** 能力四条：发丝线行（app 设置行语法），双语短句。 */
import L from "~/components/L.astro";

const rows = [
  {
    en: ["One queue, ordered by time", "It doesn't guess what you want to read. What arrived today is on top."],
    zh: ["一条队列，按时间排序", "不猜你想读什么，只把今天到的放在最上面。"],
  },
  {
    en: ["Keyboard is the interface", "j/k to scan, Enter to read, m to move on."],
    zh: ["键盘即界面", "j/k 扫读，Enter 阅读，m 读完就走。"],
  },
  {
    en: ["Reads like paper", "A single quiet column and a hairline of progress. Nothing else."],
    zh: ["像纸一样阅读", "单栏正文，一条发丝进度线，没有别的。"],
  },
  {
    en: ["Local-first, forever", "One SQLite file on your machine. OPML in, OPML out."],
    zh: ["本地优先，一直如此", "数据在本机一个 SQLite 文件里，OPML 随进随出。"],
  },
];
---

<section id="features" class="mx-auto max-w-6xl scroll-mt-24 py-10">
  <p class="section-eyebrow"><L en="WHAT IT DOES" zh="它做什么" /></p>
  <div class="mt-4 border-t border-[var(--color-hairline)]">
    {
      rows.map((row, i) => (
        <div class="feat-row grid grid-cols-[auto_minmax(0,1fr)_minmax(0,2fr)] items-baseline gap-6 border-b border-[var(--color-hairline)] py-7">
          <span class="font-mono text-[11px] text-[var(--color-ter)]">
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="text-[17px] font-semibold tracking-tight">
            <L en={row.en[0]} zh={row.zh[0]} />
          </h3>
          <p class="text-[14.5px] leading-relaxed text-[var(--color-text-offset)]">
            <L en={row.en[1]} zh={row.zh[1]} />
          </p>
        </div>
      ))
    }
  </div>
</section>

<style>
  @media (max-width: 768px) {
    .feat-row {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .feat-row p {
      grid-column: 2;
    }
  }
</style>
